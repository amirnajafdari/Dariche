---
import { getStaticLangPaths, href, num, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { services, supportingOfferings } from '@/data/services';
import { home } from '@/data/pages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import Icon from '@/components/Icon.astro';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const title = lang === 'fa' ? 'خدمات دریچه | طراحی سایت، سئو و سئو محلی' : 'Services | Web Design, SEO & Local SEO | Daricheh';
const description =
  lang === 'fa'
    ? 'طراحی سایت، سئو، سئو محلی، فروشگاه اینترنتی، بازطراحی و پشتیبانی سایت برای بیزینس‌های ایرانی در بریتانیا.'
    : 'Web design, SEO, local SEO, ecommerce, redesigns and website support for Iranian-owned businesses in the UK.';
const crumbs = [{ name: t.services, path: href(lang, 'services') }];
---
<BaseLayout lang={lang} path="services" title={title} description={description} breadcrumbs={crumbs}>
  <PageHero lang={lang} title={home.services.title[lang]} lead={home.intro.text[lang]} variant="split" breadcrumbs={crumbs} />

  <section class="section all-svc" aria-label={t.services}>
    <div class="container">
      <ol role="list" class="all-svc__grid">
        {services.map((s, i) => (
          <li class="d-card d-service-card" data-reveal style={`--delay:${(i % 2) * 0.05}s`}>
            <a href={href(lang, s.slug)} class="d-service-card__link">
              <div class="d-service-card__top">
                <span class="d-service-card__num">{num(lang, String(i + 1).padStart(2, '0'))}</span>
                <span class="d-service-card__disc" aria-hidden="true"><Icon name="arrow" /></span>
              </div>
              <div class="d-service-card__body">
                <h2 class="d-card__title d-service-card__title">{s.name[lang]}</h2>
                <p class="d-service-card__text">{s.homeBlurb[lang]}</p>
              </div>
              <div class="d-service-card__foot">
                <span class="d-service-card__cta">
                  {t.fullDetails}
                  <Icon name="arrow" />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <ul role="list" class="all-svc__extra">
        {supportingOfferings.map((o) => (
          <li class="d-card all-svc__extra-card" data-reveal>
            <a href={href(lang, o.link)} class="d-info-card__link">
              <strong class="all-svc__extra-title">{o.name[lang]}</strong>
              <span class="all-svc__extra-blurb">{o.blurb[lang]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCTA lang={lang} />
</BaseLayout>

<style>
  .all-svc {
    background: var(--paper-2);
    border-top: 1px solid var(--line);
  }
  .all-svc__grid {
    display: grid;
    gap: clamp(1.15rem, 0.9rem + 1vw, 1.65rem);
  }
  @media (min-width: 720px) {
    .all-svc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .all-svc__extra {
    display: grid;
    gap: clamp(1rem, 0.85rem + 0.8vw, 1.4rem);
    margin-top: var(--stack-xl);
  }
  @media (min-width: 800px) {
    .all-svc__extra {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .all-svc__extra-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    transition: color 0.25s ease;
  }
  .all-svc__extra-card:hover .all-svc__extra-title {
    color: var(--green-deep);
  }
  .all-svc__extra-blurb {
    font-size: var(--fs-small);
    color: var(--ink-2);
    line-height: 1.75;
  }
</style>
