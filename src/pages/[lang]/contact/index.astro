---
import { getStaticLangPaths, href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { contactPage } from '@/data/pages';
import { pageSeo } from '@/data/seo';
import { site, phoneUrl, emailUrl } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import SecondaryButton from '@/components/SecondaryButton.astro';
import Icon from '@/components/Icon.astro';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const crumbs = [{ name: t.contact, path: href(lang, 'contact') }];
---
<BaseLayout lang={lang} path="contact" title={pageSeo.contact.title[lang]} description={pageSeo.contact.description[lang]} breadcrumbs={crumbs}>
  <PageHero lang={lang} title={contactPage.title[lang]} lead={contactPage.lead[lang]} variant="type" breadcrumbs={crumbs} />

  <section class="section contact" aria-label={t.contact}>
    <div class="container contact__grid">
      <aside class="contact__direct" data-hide-wa>
        <h2 class="eyebrow">{contactPage.direct[lang]}</h2>
        <WhatsAppButton lang={lang} variant="primary" class="contact__wa" />
        <ul role="list" class="contact__lines">
          <li><a href={phoneUrl()}><Icon name="phone" /><span class="ltr">{site.contact.phoneDisplay}</span></a></li>
          <li><a href={emailUrl()}><Icon name="mail" /><span class="ltr">{site.contact.email}</span></a></li>
          {site.social.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener me"><Icon name={s.name === 'Instagram' ? 'instagram' : 'linkedin'} />{s.name}</a></li>
          ))}
        </ul>
        {/* Booking slot: appears once site.booking is enabled */}
        {site.booking.enabled && site.booking.url && (
          <SecondaryButton href={site.booking.url} external icon="arrow">{t.bookCall}</SecondaryButton>
        )}
      </aside>

      <div class="contact__form" id="form">
        <h2 class="h3">{contactPage.formTitle[lang]}</h2>
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-top: 0;
  }
  .contact__grid {
    display: grid;
    gap: var(--section-sm);
  }
  .contact__direct {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    justify-items: start;
  }
  .contact__lines {
    display: grid;
    gap: 0.25rem;
    width: 100%;
  }
  .contact__lines a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s;
  }
  .contact__lines a:hover {
    color: var(--green);
  }
  .contact__lines .icon {
    color: var(--green);
  }
  .contact__form {
    display: grid;
    gap: var(--stack-md);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }
  @media (min-width: 960px) {
    .contact__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
    .contact__direct {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
    .contact__form {
      grid-column: 6 / -1;
    }
  }
</style>
