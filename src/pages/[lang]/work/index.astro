---
import { getStaticLangPaths, href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { caseStudies } from '@/data/caseStudies';
import { visible } from '@/data/site';
import { workPage } from '@/data/pages';
import { pageSeo } from '@/data/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import FinalCTA from '@/components/FinalCTA.astro';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const items = visible(caseStudies);
const crumbs = [{ name: lang === 'fa' ? 'نمونه‌کارها' : 'Work', path: href(lang, 'work') }];
---
<BaseLayout lang={lang} path="work" title={pageSeo.work.title[lang]} description={pageSeo.work.description[lang]} breadcrumbs={crumbs}>
  <PageHero lang={lang} title={workPage.title[lang]} lead={workPage.lead[lang]} variant="type" breadcrumbs={crumbs} />

  <section class="section work-all" aria-label={crumbs[0].name}>
    <div class="container">
      {items.length === 0 && <p class="lead">{t.sampleNote}</p>}
      <div class="work-all__grid">
        {items.map((cs) => (
          <CaseStudyCard cs={cs} lang={lang} headingLevel="h2" />
        ))}
      </div>
    </div>
  </section>

  <FinalCTA lang={lang} />
</BaseLayout>

<style>
  .work-all {
    padding-top: 0;
  }
  .work-all__grid {
    display: grid;
    gap: var(--col-gap);
  }
  @media (min-width: 700px) {
    .work-all__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
