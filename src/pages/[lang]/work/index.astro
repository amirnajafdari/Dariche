---
import { getStaticLangPaths, href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { caseStudies } from '@/data/caseStudies';
import { visible } from '@/data/site';
import { workPage } from '@/data/pages';
import { pageSeo } from '@/data/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import FinalCTA from '@/components/FinalCTA.astro';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const items = visible(caseStudies);
const crumbs = [{ name: lang === 'fa' ? 'نمونه‌کارها' : 'Work', path: href(lang, 'work') }];
// Rhythm repeats every four: wide / tall offset / tall / wide offset
const shapes = ['wide', 'tall', 'tall', 'wide'] as const;
---
<BaseLayout lang={lang} path="work" title={pageSeo.work.title[lang]} description={pageSeo.work.description[lang]} breadcrumbs={crumbs}>
  <PageHero lang={lang} title={workPage.title[lang]} lead={workPage.lead[lang]} variant="type" breadcrumbs={crumbs} />

  <section class="section work-all" aria-label={crumbs[0].name}>
    <div class="container">
      {items.length === 0 && <p class="lead">{t.sampleNote}</p>}
      <div class="work-all__grid">
        {items.map((cs, i) => (
          <CaseStudyCard cs={cs} lang={lang} shape={shapes[i % 4]} headingLevel="h2" class={`work-all__item work-all__item--${(i % 4) + 1}`} />
        ))}
      </div>
    </div>
  </section>

  <FinalCTA lang={lang} />
</BaseLayout>

<style>
  .work-all {
    padding-top: 0;
  }
  .work-all__grid {
    display: grid;
    gap: var(--stack-xl);
  }
  @media (min-width: 700px) {
    .work-all__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }
    .work-all__item--1 {
      grid-column: 1 / span 8;
    }
    .work-all__item--2 {
      grid-column: 9 / span 4;
      margin-top: clamp(6rem, 2rem + 10vw, 14rem);
    }
    .work-all__item--3 {
      grid-column: 2 / span 4;
    }
    .work-all__item--4 {
      grid-column: 6 / span 7;
      margin-top: clamp(4rem, 2rem + 8vw, 11rem);
    }
  }
</style>
