---
import { getStaticLangPaths, href, type Lang } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PrimaryButton from '@/components/PrimaryButton.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const copy = {
  fa: {
    title: 'ممنون از پیامت | دریچه',
    headline: ['مرسی،', 'پیامت رسید.'],
    lead: 'ممنون که با دریچه تماس گرفتی. به‌زودی باهات تماس می‌گیریم. اگر سؤال دیگه‌ای داری، توی واتساپ بهمون پیام بده.',
    home: 'بازگشت به صفحه اصلی',
    whatsapp: 'توی واتساپ پیام بده',
  },
  en: {
    title: 'Thank you | Daricheh',
    headline: ['Thank you.', 'Message received.'],
    lead: "Thanks for getting in touch with Daricheh. We'll be in touch soon. If you have another question, you can message us on WhatsApp.",
    home: 'Back to homepage',
    whatsapp: 'Message us on WhatsApp',
  },
}[lang];
---
<BaseLayout lang={lang} path="thank-you" title={copy.title} description={copy.lead} noindex>
  <div data-hide-wa>
    <PageHero lang={lang} title={copy.headline} lead={copy.lead}>
      <PrimaryButton href={href(lang)}>{copy.home}</PrimaryButton>
      <WhatsAppButton lang={lang} variant="quiet" label={copy.whatsapp} />
    </PageHero>
  </div>
</BaseLayout>
