---
import { getStaticLangPaths, type Lang } from '@/i18n';
import { pageSeo, finglishPhrases } from '@/data/seo';
import { homeFaqs } from '@/data/faqs';
import { faqSchema, pricingCatalogSchema, professionalService } from '@/lib/schema';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import HomeIntro from '@/components/home/HomeIntro.astro';
import HomeFounders from '@/components/home/HomeFounders.astro';
import HomeServices from '@/components/home/HomeServices.astro';
import PortfolioMarquee from '@/components/home/PortfolioMarquee.astro';
import HomePricing from '@/components/home/HomePricing.astro';
import HomeFaq from '@/components/home/HomeFaq.astro';
import HomeContact from '@/components/home/HomeContact.astro';

// Persian has its own homepage entry so its verified Persian contact settings stay scoped cleanly.
export const getStaticPaths = () => getStaticLangPaths().filter(({ params }) => params.lang !== 'fa');
const lang = Astro.params.lang as Lang;
const faqs = homeFaqs[lang];
---
<BaseLayout
  lang={lang}
  path=""
  title={pageSeo.home.title[lang]}
  description={pageSeo.home.description[lang]}
  keywords={finglishPhrases.home}
  schema={[professionalService(lang), pricingCatalogSchema(lang), faqSchema(faqs)]}
>
  <Hero lang={lang} />
  <HomeIntro lang={lang} />
  <HomeFounders lang={lang} />
  <HomeServices lang={lang} />
  <PortfolioMarquee lang={lang} />
  <HomePricing lang={lang} />
  <HomeFaq lang={lang} />
  <HomeContact lang={lang} />
</BaseLayout>
