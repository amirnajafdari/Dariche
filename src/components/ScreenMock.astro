---
/**
 * Abstract website mock-up, drawn in CSS. A deliberate placeholder until real project
 * screenshots exist — swap for <img> by giving the case study a `cover`.
 */
import type { MockKind } from '@/data/caseStudies';

interface Props {
  kind: MockKind;
  bg: string;
  accent: string;
  title: string;
  device?: 'desktop' | 'mobile';
  class?: string;
}
const { kind, bg, accent, title, device = 'desktop', class: className } = Astro.props;
---
<div class:list={['mock', `mock--${kind}`, `mock--${device}`, className]} style={`--m-bg:${bg};--m-ac:${accent}`} aria-hidden="true">
  <div class="mock__bar"><span></span></div>
  <div class="mock__page">
    <div class="mock__nav">
      <b>{title}</b>
      <i></i><i></i><i></i>
    </div>

    {kind === 'restaurant' && (
      <div class="mock__body">
        <div class="mock__hero">
          <div class="mock__copy">
            <p class="mock__title">{title}</p>
            <i class="l1"></i><i class="l2"></i>
            <span class="mock__btn"></span>
          </div>
          <div class="mock__img mock__img--plate"><span></span></div>
        </div>
        <div class="mock__rows"><i></i><i></i><i></i></div>
      </div>
    )}

    {kind === 'clinic' && (
      <div class="mock__body mock__body--center">
        <p class="mock__title">{title}</p>
        <i class="l1"></i>
        <span class="mock__btn"></span>
        <div class="mock__cols"><i></i><i></i><i></i></div>
      </div>
    )}

    {kind === 'salon' && (
      <div class="mock__body">
        <p class="mock__title">{title}</p>
        <i class="l2"></i>
        <div class="mock__gallery"><span></span><span></span><span></span><span></span></div>
      </div>
    )}

    {kind === 'shop' && (
      <div class="mock__body">
        <p class="mock__title">{title}</p>
        <div class="mock__products">
          {[1, 2, 3, 4, 5, 6, 7, 8].map(() => (
            <div><span></span><i></i><i class="short"></i></div>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .mock {
    container-type: inline-size;
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--m-bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--m-ac);
  }
  .mock__bar {
    flex: none;
    height: 4.5cqw;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--m-bg) 80%, #fff);
    border-bottom: 1px solid color-mix(in srgb, var(--m-ac) 10%, transparent);
  }
  .mock__bar span {
    width: 26%;
    height: 1.6cqw;
    border-radius: 99px;
    background: color-mix(in srgb, var(--m-ac) 9%, transparent);
  }
  .mock__page {
    flex: 1;
    padding: 4cqw 6cqw;
    display: flex;
    flex-direction: column;
    gap: 4cqw;
  }
  .mock__nav {
    display: flex;
    align-items: center;
    gap: 3cqw;
  }
  .mock__nav b {
    font-size: 2.1cqw;
    font-weight: 700;
    margin-inline-end: auto;
    white-space: nowrap;
  }
  .mock__nav i {
    width: 6cqw;
    height: 0.9cqw;
    border-radius: 9px;
    background: color-mix(in srgb, var(--m-ac) 22%, transparent);
  }
  .mock__title {
    font-size: 5.4cqw;
    line-height: 1.15;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--m-ac);
    margin: 0;
  }
  .mock i,
  .mock .l1,
  .mock .l2 {
    display: block;
  }
  .l1,
  .l2 {
    height: 1.2cqw;
    border-radius: 9px;
    background: color-mix(in srgb, var(--m-ac) 18%, transparent);
  }
  .l1 {
    width: 70%;
  }
  .l2 {
    width: 48%;
  }
  .mock__btn {
    display: block;
    width: 16cqw;
    height: 4.4cqw;
    border-radius: 0.8cqw;
    background: var(--m-ac);
  }
  .mock__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2.4cqw;
  }
  .mock__body--center {
    align-items: center;
    text-align: center;
    padding-top: 3cqw;
  }

  /* restaurant */
  .mock__hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 5cqw;
    align-items: center;
  }
  .mock__copy {
    display: grid;
    gap: 2.2cqw;
  }
  .mock__img {
    aspect-ratio: 1 / 1;
    background: color-mix(in srgb, var(--m-ac) 14%, var(--m-bg));
    display: grid;
    place-items: center;
    border-radius: 999px 999px 0 0;
  }
  .mock__img--plate span {
    width: 54%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--m-ac) 30%, #fff);
    box-shadow: inset 0 0 0 2.2cqw color-mix(in srgb, #fff 70%, var(--m-bg));
  }
  .mock__rows {
    display: grid;
    gap: 1.6cqw;
    margin-top: auto;
  }
  .mock__rows i {
    height: 1px;
    background: color-mix(in srgb, var(--m-ac) 20%, transparent);
  }

  /* clinic */
  .mock__cols {
    margin-top: auto;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5cqw;
  }
  .mock__cols i {
    height: 15cqw;
    background: color-mix(in srgb, #fff 65%, var(--m-bg));
    border-top: 0.5cqw solid var(--m-ac);
  }

  /* salon */
  .mock__gallery {
    margin-top: auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.3fr;
    gap: 2cqw;
    align-items: end;
  }
  .mock__gallery span {
    display: block;
    background: color-mix(in srgb, var(--m-ac) 22%, var(--m-bg));
  }
  .mock__gallery span:nth-child(1) {
    height: 22cqw;
  }
  .mock__gallery span:nth-child(2) {
    height: 16cqw;
    background: color-mix(in srgb, var(--m-ac) 38%, var(--m-bg));
  }
  .mock__gallery span:nth-child(3) {
    height: 19cqw;
  }
  .mock__gallery span:nth-child(4) {
    height: 25cqw;
    background: color-mix(in srgb, var(--m-ac) 12%, var(--m-bg));
  }

  /* shop */
  .mock__products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.4cqw;
  }
  .mock__products div {
    display: grid;
    gap: 1cqw;
  }
  .mock__products span {
    aspect-ratio: 1;
    background: color-mix(in srgb, #fff 55%, var(--m-bg));
    display: grid;
    place-items: center;
  }
  .mock__products span::after {
    content: '';
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0.35cqw solid color-mix(in srgb, #b89b5e 80%, var(--m-ac));
  }
  .mock__products i {
    height: 0.9cqw;
    background: color-mix(in srgb, var(--m-ac) 18%, transparent);
    border-radius: 9px;
  }
  .mock__products i.short {
    width: 40%;
  }

  /* mobile device: everything scales from width, so just stack */
  .mock--mobile .mock__bar {
    height: 9cqw;
  }
  .mock--mobile .mock__bar span {
    width: 40%;
    height: 3cqw;
  }
  .mock--mobile .mock__page {
    padding: 8cqw 8cqw;
    gap: 8cqw;
  }
  .mock--mobile .mock__nav i {
    display: none;
  }
  .mock--mobile .mock__nav b {
    font-size: 5cqw;
  }
  .mock--mobile .mock__title {
    font-size: 11cqw;
  }
  .mock--mobile .mock__hero {
    grid-template-columns: 1fr;
  }
  .mock--mobile .mock__body {
    gap: 5cqw;
  }
  .mock--mobile :is(.l1, .l2) {
    height: 2.6cqw;
  }
  .mock--mobile .mock__btn {
    width: 40cqw;
    height: 11cqw;
    border-radius: 2cqw;
  }
  .mock--mobile .mock__cols,
  .mock--mobile .mock__products {
    grid-template-columns: 1fr 1fr;
    gap: 4cqw;
  }
  .mock--mobile .mock__cols i {
    height: 30cqw;
  }
  .mock--mobile .mock__gallery {
    grid-template-columns: 1fr 1fr;
    gap: 4cqw;
  }
  .mock--mobile .mock__gallery span {
    height: 40cqw !important;
  }
</style>
