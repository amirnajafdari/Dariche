---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import type { CaseStudy } from '@/data/caseStudies';
import { getService } from '@/data/services';
import ProjectVisual from './ProjectVisual.astro';
import Icon from './Icon.astro';

interface Props {
  cs: CaseStudy;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
  class?: string;
  style?: string;
}
const { cs, lang, headingLevel: H = 'h3', class: className, style } = Astro.props;
const t = useTranslations(lang);
const url = href(lang, `work/${cs.slug}`);
const services = cs.services.map((s) => getService(s)?.name[lang]).filter(Boolean).join(' / ');
---
<article class:list={['case-card', className]} style={style} data-reveal>
  <div class="case-card__pane">
    <ProjectVisual cs={cs} lang={lang} sizes="(min-width: 700px) 50vw, 100vw" />
  </div>
  <div class="case-card__meta">
    <p class="case-card__info">
      <span>{cs.industry[lang]}</span>
      <span aria-hidden="true">·</span>
      <span>{cs.location[lang]}</span>
      {cs.sample && <span class="sample-tag" title={t.sampleNote}>{t.sample}</span>}
    </p>
    <H class="case-card__title">
      <a href={url} class="case-card__link">{cs.client[lang]}</a>
    </H>
    <p class="case-card__summary">{cs.summary[lang]}</p>
    {cs.result && <p class="case-card__result">{cs.result[lang]}</p>}
    <p class="case-card__foot">
      <span class="case-card__services">{services}</span>
      <span class="case-card__go" aria-hidden="true"><Icon name="arrow" /></span>
    </p>
  </div>
</article>

<style>
  .case-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(0.75rem, 0.5rem + 0.6vw, 1.25rem);
    border-radius: var(--radius);
    background: var(--paper-2);
    box-shadow: 0 8px 24px rgb(29 31 34 / 4%);
    transition: box-shadow 0.35s var(--ease);
  }
  .case-card__pane {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper);
  }
  .case-card__meta {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 0.8rem + 1vw, 2rem) clamp(0.25rem, 1vw, 1rem) 0.5rem;
  }
  .case-card__info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .case-card__info .sample-tag {
    margin-inline-start: 0.5rem;
  }
  .case-card__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.25;
  }
  /* stretched link: the whole card is clickable, the accessible name stays short */
  .case-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .case-card__link:focus-visible {
    outline: none;
  }
  .case-card:has(.case-card__link:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: 6px;
  }
  .case-card__summary {
    color: var(--ink-2);
  }
  .case-card__result {
    color: var(--green);
    font-weight: 500;
  }
  .case-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    margin-top: auto;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .case-card__go {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    background: var(--green-tint);
    border-radius: 50%;
    color: var(--green);
    transition: background-color 0.35s, color 0.35s;
  }
  .case-card:hover .case-card__go,
  .case-card:focus-within .case-card__go {
    background: var(--green);
    color: #fff;
  }
  .case-card:hover .case-card__title a,
  .case-card:focus-within .case-card__title a {
    color: var(--green);
  }
  .case-card:hover {
    box-shadow: 0 12px 32px rgb(29 31 34 / 8%);
  }
</style>
