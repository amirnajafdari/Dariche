---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { formatGbp, type OneOffService } from '@/data/pricing';
import PersianText from './home/PersianText.astro';
import SecondaryButton from './SecondaryButton.astro';

interface Props {
  service: OneOffService;
  lang: Lang;
  headingLevel?: 'h2' | 'h3' | 'h4';
  /** Optional custom CTA URL override (e.g. homepage callback anchor) */
  ctaHref?: string;
}

const { service, lang, headingLevel: H = 'h3', ctaHref } = Astro.props;
const t = useTranslations(lang);
const contactUrl = ctaHref ?? `${href(lang, 'contact')}?package=${encodeURIComponent(service.id)}#form`;
const amount = formatGbp(service.price);
---
<article class="d-card d-price-card oneoff-card" id={service.id} aria-labelledby={`oneoff-${service.id}`}>
  <header class="d-price-card__head">
    <H class="d-card__title" id={`oneoff-${service.id}`}>{service.title[lang]}</H>
  </header>

  <p class="d-price-card__price-tray">
    {service.from && <span class="d-price-card__prefix">{t.from} </span>}
    <bdi dir="ltr" class="d-price-card__amount">{amount}</bdi>
    <span class="d-price-card__period">— {service.billingNote[lang]}</span>
  </p>

  <div class="d-price-card__copy">
    <p class="d-price-card__tagline"><strong>{service.tagline[lang]}</strong></p>
    <p class="d-price-card__desc">
      {lang === 'fa' ? <PersianText text={service.description.fa} /> : service.description.en}
    </p>
  </div>

  <div class="d-price-card__features">
    <p class="d-price-card__list-label">{service.listLabel[lang]}</p>
    <ul class="d-price-card__list" role="list">
      {service.features[lang].map((feature) => (
        <li>{lang === 'fa' ? <PersianText text={feature} /> : feature}</li>
      ))}
    </ul>
  </div>

  <div class="d-price-card__cta">
    <SecondaryButton href={contactUrl} icon="arrow">{service.cta[lang]}</SecondaryButton>
  </div>
</article>

<style>
  .oneoff-card {
    height: 100%;
  }
</style>
