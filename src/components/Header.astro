---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { mainNav, serviceMenu } from '@/data/navigation';
import { getService } from '@/data/services';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MegaMenu from './MegaMenu.astro';
import PrimaryButton from './PrimaryButton.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;
const isCurrent = (p: string) => (p === '' ? path === href(lang) : path.startsWith(href(lang, p)));
const servicePaths = serviceMenu.map((s) => href(lang, s));
const inServices = servicePaths.some((p) => path.startsWith(p)) || path.startsWith(href(lang, 'services'));
const navLabel = lang === 'fa' ? 'منوی اصلی' : 'Main';
---
<header class="site-header" data-header>
  <div class="container site-header__bar">
    <Logo lang={lang} />

    <nav class="site-nav" aria-label={navLabel}>
      <ul class="site-nav__list" role="list">
        {mainNav.map((item) => (
          <li>
            {item.menu ? (
              <button
                type="button"
                class="site-nav__link"
                aria-expanded="false"
                aria-controls="mega-services"
                data-mega-toggle
                aria-current={inServices ? 'true' : undefined}
              >
                {item.label[lang]}
                <svg class="site-nav__caret" viewBox="0 0 10 6" aria-hidden="true"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
              </button>
            ) : (
              <a href={href(lang, item.path)} class="site-nav__link" aria-current={isCurrent(item.path ?? '') ? 'page' : undefined}>
                {item.label[lang]}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher lang={lang} alternates={alternates} class="site-header__lang" />
      <PrimaryButton href={href(lang, 'contact')} icon="none" class="site-header__cta">{t.letsTalk}</PrimaryButton>
      <button type="button" class="menu-btn" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" />
        <span>{t.menu}</span>
      </button>
    </div>
  </div>

  <MegaMenu lang={lang} id="mega-services" />
</header>

<dialog class="drawer" id="mobile-menu" aria-label={t.menu} data-drawer>
  <div class="drawer__top">
    <Logo lang={lang} />
    <button type="button" class="drawer__close" data-menu-close>
      <Icon name="close" />
      <span class="sr-only">{t.closeMenu}</span>
    </button>
  </div>

  <nav class="drawer__nav" aria-label={navLabel}>
    <ul role="list">
      {mainNav.map((item) =>
        item.menu ? (
          <li>
            <details class="drawer__group" open={inServices}>
              <summary class="drawer__link">
                {item.label[lang]}
                <Icon name="plus" class="drawer__plus" />
              </summary>
              <ul role="list" class="drawer__sub">
                {serviceMenu.map((slug) => (
                  <li>
                    <a href={href(lang, slug)} aria-current={path === href(lang, slug) ? 'page' : undefined}>{getService(slug)!.name[lang]}</a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <li>
            <a href={href(lang, item.path)} class="drawer__link" aria-current={isCurrent(item.path ?? '') ? 'page' : undefined}>
              {item.label[lang]}
            </a>
          </li>
        )
      )}
    </ul>
  </nav>

  <div class="drawer__foot">
    <PrimaryButton href={href(lang, 'contact')}>{t.letsTalk}</PrimaryButton>
    <WhatsAppButton lang={lang} variant="quiet" />
    <LanguageSwitcher lang={lang} alternates={alternates} />
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    transition: box-shadow 0.4s;
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background: rgb(255 255 255 / 0.88);
      backdrop-filter: saturate(1.4) blur(10px);
    }
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
    transition: height 0.45s var(--ease);
  }
  .site-header.is-compact .site-header__bar {
    height: 4rem;
  }
  .site-header.is-compact {
    box-shadow: 0 1px 0 var(--line);
  }

  .site-nav {
    margin-inline: auto;
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.2rem + 1.6vw, 2.4rem);
  }
  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-size: 0.98rem;
    color: var(--ink-2);
    transition: color 0.25s;
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0.45rem;
    height: 1px;
    background: var(--green);
    transform: scaleX(0);
    transition: transform 0.4s var(--ease);
  }
  .site-nav__link:hover,
  .site-nav__link[aria-current],
  .site-nav__link[aria-expanded='true'] {
    color: var(--ink);
  }
  .site-nav__link[aria-current]::after,
  .site-nav__link:hover::after {
    transform: scaleX(1);
  }
  .site-nav__caret {
    width: 0.6rem;
    transition: transform 0.3s var(--ease);
  }
  [aria-expanded='true'] > .site-nav__caret {
    transform: rotate(180deg);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .site-header__cta {
    min-height: 2.85rem;
    padding-inline: 1.25rem;
    font-size: 0.95rem;
  }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .menu-btn .icon {
    width: 1.4rem;
    height: 1.4rem;
  }

  @media (max-width: 1079px) {
    .site-nav,
    .site-header :global(.mega) {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .site-header__actions {
      margin-inline-start: auto;
    }
  }
  @media (max-width: 639px) {
    .site-header__cta,
    .site-header__actions > :global(.site-header__lang) {
      display: none;
    }
    .site-header__bar {
      height: 4.5rem;
    }
  }

  /* Mobile drawer */
  .drawer {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0 var(--gutter) max(2rem, env(safe-area-inset-bottom));
    border: 0;
    background: var(--paper);
    color: var(--ink);
    overflow-y: auto;
    flex-direction: column;
  }
  .drawer[open] {
    display: flex;
    animation: drawer-in 0.5s var(--ease);
  }
  .drawer::backdrop {
    background: rgb(29 31 34 / 0.2);
  }
  @keyframes drawer-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer[open] {
      animation: none;
    }
  }
  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
  }
  .drawer__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
  }
  .drawer__close .icon {
    width: 1.5rem;
    height: 1.5rem;
  }
  .drawer__nav {
    padding-block: 2rem;
  }
  .drawer__nav > ul > li {
    border-bottom: 1px solid var(--line);
  }
  .drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    font-size: 1.6rem;
    font-weight: 300;
    list-style: none;
    cursor: pointer;
  }
  .drawer__link::-webkit-details-marker {
    display: none;
  }
  .drawer__link[aria-current] {
    color: var(--green);
  }
  .drawer__plus {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s var(--ease);
  }
  .drawer__group[open] .drawer__plus {
    transform: rotate(45deg);
  }
  .drawer__sub {
    display: grid;
    padding-bottom: 1rem;
  }
  .drawer__sub a {
    display: flex;
    align-items: center;
    min-height: 2.9rem;
    color: var(--ink-2);
  }
  .drawer__sub a[aria-current] {
    color: var(--green);
  }
  .drawer__foot {
    margin-top: auto;
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .drawer__foot > :global(.btn) {
    width: 100%;
  }
</style>
