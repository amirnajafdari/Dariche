---
import { Picture } from 'astro:assets';
import { href, type Lang } from '@/i18n';
import { site } from '@/data/site';
import logoImg from '@/assets/logo.png';

interface Props {
  lang: Lang;
  size?: 'md' | 'lg';
  link?: boolean;
}
const { lang, size = 'md', link = true } = Astro.props;
const Tag = link ? 'a' : 'span';
const linkProps = link ? { href: href(lang) } : {};
const sizes = size === 'lg' ? '(min-width: 960px) 180px, 150px' : '120px';
---
<Tag class:list={['logo', `logo--${size}`]} {...linkProps}>
  <Picture
    src={logoImg}
    alt={site.name[lang]}
    widths={[320, 640, 1024]}
    sizes={sizes}
    formats={['webp']}
    fallbackFormat="png"
    quality={95}
    class="logo__img"
    loading={size === 'md' ? 'eager' : 'lazy'}
    decoding="async"
  />
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    line-height: 0;
  }
  .logo :global(picture) {
    display: block;
    line-height: 0;
  }
  .logo__img {
    display: block;
    height: 2.65rem;
    width: auto;
    object-fit: contain;
    transition: height 0.45s var(--ease), transform 0.5s var(--ease);
  }
  :global(.site-header.is-compact) .logo--md .logo__img {
    height: 2.25rem;
  }
  .logo--lg .logo__img {
    height: clamp(3.25rem, 2.5rem + 1.8vw, 4.4rem);
  }
  a.logo:hover .logo__img {
    transform: translateY(-1px);
  }
</style>
