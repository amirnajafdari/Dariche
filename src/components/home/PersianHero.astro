---
import { contactForm, homeWhatsApp, persianHomeContact } from '@/data/persianHome';
import Headline from '../Headline.astro';
import PrimaryButton from '../PrimaryButton.astro';
import SecondaryButton from '../SecondaryButton.astro';
import WhatsAppButton from '../WhatsAppButton.astro';

const lang = 'fa';
---
<section class="hero" aria-labelledby="hero-title">
  <!-- Original artwork, served untouched (no resizing or re-encoding) -->
  <picture class="hero__bg-wrap" aria-hidden="true">
    <img
      src="/images/hero/hero-fa.png"
      width="1672"
      height="941"
      alt=""
      class="hero__bg"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </picture>
  <div class="container hero__grid">
    <div class="hero__copy">
      <Headline lines={['یه دریچه برای', 'دیده شدن بیزینست.']} as="h1" size="display" id="hero-title" class="hero__title" />
      <div class="hero__text" data-reveal style="--delay:.25s">
        <p class="lead">طراحی سایت، سئو و خدمات دیجیتال برای بیزینس‌های ایرانی در بریتانیا. از ساخت یه سایت حرفه‌ای تا بهتر دیده شدن توی گوگل، کمک می‌کنیم مشتری‌های بیشتری با بیزینست آشنا بشن.</p>
        <p class="hero__sub"><strong>دو تا طراح، یه استودیوی کوچیک و کلی وسواس روی جزئیات.</strong></p>
      </div>
      <div class="hero__actions" data-reveal style="--delay:.35s" data-hide-wa>
        <div class="btn-row">
          <PrimaryButton href={contactForm} icon="none">بیا حرف بزنیم</PrimaryButton>
          <SecondaryButton href="#work">کارامون رو ببین</SecondaryButton>
        </div>
        <WhatsAppButton lang={lang} variant="quiet" urlOverride={homeWhatsApp} label={persianHomeContact.whatsapp ? 'یا مستقیم توی واتساپ پیام بده' : 'درخواست تماس ثبت کن'} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #f6f4f1;
    display: flex;
    flex-direction: column;
    padding-top: clamp(2.75rem, 6vw, 4.5rem);
  }
  .hero__bg-wrap {
    order: 2;
    display: block;
    width: 100%;
    margin-top: clamp(2rem, 5vw, 3rem);
    pointer-events: none;
    user-select: none;
  }
  .hero__bg {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: left center;
  }
  .hero__grid {
    order: 1;
    position: relative;
    display: grid;
  }
  .hero__copy {
    display: grid;
    gap: var(--stack-md);
    align-content: center;
    max-width: 34rem;
  }
  .hero__title {
    font-size: clamp(2.4rem, 1.1rem + 3.6vw, 4.4rem);
    line-height: 1.5;
  }
  .hero__text {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }
  .hero__sub {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }
  .hero__actions {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 0.75rem;
  }

  @media (min-width: 960px) {
    .hero {
      flex-direction: row;
      align-items: center;
      min-height: clamp(38rem, 78vh, 52rem);
      padding-block: clamp(4rem, 5vw, 6.5rem);
    }
    .hero__bg-wrap {
      order: 0;
      position: absolute;
      inset: 0;
      margin-top: 0;
      z-index: -1;
    }
    .hero__bg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left center;
    }
    .hero__grid {
      order: 0;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: center;
    }
    .hero__copy {
      grid-column: 1 / span 6;
    }
  }

  @media (min-width: 1240px) {
    .hero__copy {
      grid-column: 1 / span 5;
    }
  }
</style>
