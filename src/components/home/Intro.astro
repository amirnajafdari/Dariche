---
import type { Lang } from '@/i18n';
import { home } from '@/data/pages';
import Headline from '../Headline.astro';
import HomeIllustration from './HomeIllustration.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<section class="intro section" aria-labelledby="intro-title">
  <div class="container intro__grid">
    <Headline lines={home.intro.title[lang]} id="intro-title" class="intro__title" />
    <div class="intro__visual" data-reveal>
      <HomeIllustration scene="website" />
    </div>
    <p class="intro__text lead" data-reveal style="--delay:.15s">{home.intro.text[lang]}</p>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    gap: var(--stack-lg);
    align-items: center;
  }
  .intro__visual {
    min-width: 0;
  }
  @media (min-width: 960px) {
    .intro__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
    .intro__title {
      grid-column: 2 / span 9;
    }
    .intro__visual {
      grid-column: 1 / span 5;
    }
    .intro__text {
      grid-column: 7 / span 6;
    }
  }
</style>
