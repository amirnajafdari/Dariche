---
import { href, type Lang } from '@/i18n';
import { getHomeFaqCategories } from '@/data/homeFaqCategories';
import PersianText from './PersianText.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const isPersian = lang === 'fa';
const categories = getHomeFaqCategories(lang);
const title = isPersian ? 'سؤال داری؟ شاید جوابش همین‌جا باشه.' : "Questions? We've got a few answers.";
---
<section id="faq" class="home-faq" dir={isPersian ? 'rtl' : 'ltr'} aria-labelledby="faq-title" data-home-faq>
  <div class="container">
    <div class="home-faq__heading">
      <h2 id="faq-title">{title}</h2>
      <div class="home-faq__intro">
        <p>{isPersian ? 'جواب چیزی که دنبالش هستی رو پیدا نکردی؟ مستقیم از خودمون بپرس.' : "Can't find what you're looking for? Ask us directly."}</p>
        <a href={href(lang, 'contact')}>{isPersian ? 'بیا حرف بزنیم' : "Let's Talk"}</a>
      </div>
    </div>
    <div class="home-faq__layout">
      <div class="home-faq__tabs" role="tablist" aria-label={isPersian ? 'موضوع سؤال‌ها' : 'FAQ categories'} aria-orientation="vertical" hidden>
        {categories.map((category, index) => (
          <button type="button" role="tab" id={`faq-tab-${category.id}`} aria-controls={`faq-panel-${category.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
            {category.label[lang]}
          </button>
        ))}
      </div>
      <div class="home-faq__panels">
        {categories.map((category) => (
          <div id={`faq-panel-${category.id}`} class="home-faq__panel" data-faq-panel>
            <h3 class="home-faq__category">{category.label[lang]}</h3>
            {category.items.map((item, index) => (
              <details class="home-faq__item" name="home-faq" data-faq-item>
                <summary id={`faq-question-${category.id}-${index}`} aria-controls={`faq-answer-${category.id}-${index}`}>
                  <span>{item.q}</span>
                  <span class="home-faq__icon" aria-hidden="true"></span>
                </summary>
                <div id={`faq-answer-${category.id}-${index}`} class="home-faq__answer">
                  {item.a.split('\n\n').map((paragraph) => <p>{isPersian ? <PersianText text={paragraph} /> : paragraph}</p>)}
                </div>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initialiseHomeFaq } from '@/scripts/homeFaq';
  document.querySelectorAll<HTMLElement>('[data-home-faq]').forEach(initialiseHomeFaq);
</script>

<style>
  .home-faq {
    --faq-line: rgb(80 69 49 / 24%);
    background: #f7f5f0;
    color: var(--ink);
    font-family: var(--font-en);
    padding-block: clamp(3rem, 5.5vw, 5rem);
  }
  .home-faq[dir='rtl'] { font-family: var(--font-fa); }
  .home-faq [hidden] { display: none !important; }
  .home-faq__heading { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: end; gap: 2rem 4rem; margin-bottom: 2.5rem; }
  .home-faq .home-faq__heading h2 {
    max-width: 22ch;
    font-family: inherit;
    font-size: clamp(2rem, 3.8vw, 3.75rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .home-faq[dir='rtl'] .home-faq__heading h2 { font-family: var(--font-fa); font-weight: 300; letter-spacing: 0; line-height: 1.55; }
  .home-faq__intro { max-width: 20rem; justify-self: end; font-size: 1rem; line-height: 1.8; }
  .home-faq__intro p { color: var(--ink-2); }
  .home-faq__intro a { display: inline-flex; align-items: center; min-height: 2.75rem; color: #226f54; text-decoration: underline; text-underline-offset: 0.3em; }
  .home-faq__layout { border-block: 1px solid var(--faq-line); }
  .home-faq[data-enhanced] .home-faq__layout { display: grid; grid-template-columns: minmax(13rem, 1fr) minmax(0, 3fr); }
  .home-faq__tabs { display: flex; flex-direction: column; gap: 0.375rem; padding-block: 1.5rem; padding-inline-end: 1.75rem; border-inline-end: 1px solid var(--faq-line); }
  .home-faq__tabs button { width: 100%; min-height: 3rem; padding: 0.75rem 1rem; border-radius: 4px; text-align: start; font-size: 0.9375rem; line-height: 1.6; transition: background-color 180ms ease, color 180ms ease; }
  .home-faq__tabs button:hover { background: rgb(34 111 84 / 7%); }
  .home-faq__tabs button[aria-selected='true'] { background: #226f54; color: #fff; }
  .home-faq :is(button, summary, a):focus-visible { outline: 2px solid #226f54; outline-offset: 3px; }
  .home-faq__panels { min-width: 0; padding-block: 1.75rem; }
  .home-faq[data-enhanced] .home-faq__panels { padding-inline-start: clamp(1.5rem, 4vw, 3rem); }
  .home-faq .home-faq__category { font: inherit; font-size: 0.8125rem; font-weight: 500; color: #226f54; margin-bottom: 1rem; }
  .home-faq[dir='ltr'] .home-faq__category { text-transform: uppercase; letter-spacing: 0.08em; }
  .home-faq__item { border-bottom: 1px solid var(--faq-line); }
  .home-faq__item:last-child { border-bottom: 0; }
  .home-faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 3.75rem; padding-block: 1rem; list-style: none; cursor: pointer; font-size: 1rem; line-height: 1.7; }
  .home-faq__item summary::-webkit-details-marker { display: none; }
  .home-faq__item summary:hover { color: #226f54; }
  .home-faq__icon { position: relative; flex: 0 0 0.75rem; height: 0.75rem; color: #226f54; }
  .home-faq__icon::before, .home-faq__icon::after { content: ''; position: absolute; inset: 50% 0 auto; height: 1px; background: currentColor; }
  .home-faq__icon::after { transform: rotate(90deg); transition: transform 220ms ease; }
  .home-faq__item[open] .home-faq__icon::after { transform: rotate(0); }
  .home-faq__item summary[aria-expanded='false'] .home-faq__icon::after { transform: rotate(90deg); }
  .home-faq__answer { padding-block: 0.125rem 1.5rem; padding-inline-end: 2.25rem; font-size: 1rem; line-height: 1.9; color: var(--ink-2); overflow-wrap: anywhere; }
  .home-faq__answer p + p { margin-top: 0.75rem; }
  @media (max-width: 699px) {
    .home-faq__heading { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; margin-bottom: 1.75rem; }
    .home-faq__intro { justify-self: start; max-width: 30rem; }
    .home-faq[data-enhanced] .home-faq__layout { grid-template-columns: minmax(0, 1fr); }
    .home-faq__tabs { flex-direction: row; overflow-x: auto; overscroll-behavior-x: contain; gap: 0.5rem; padding: 1rem 0.25rem; border-inline-end: 0; border-bottom: 1px solid var(--faq-line); scrollbar-width: thin; scrollbar-color: #226f54 transparent; }
    .home-faq__tabs button { width: auto; flex-shrink: 0; white-space: nowrap; }
    .home-faq[data-enhanced] .home-faq__panels { padding-inline-start: 0; }
    .home-faq__panels { padding-block: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-faq__tabs button, .home-faq__icon::after { transition: none; }
  }
</style>
