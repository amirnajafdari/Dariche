---
import Headline from '../Headline.astro';
import PersianText from './PersianText.astro';
import { oneOffServices, monthlyPackages, contactForm } from '@/data/persianHome';
import { pricingNote } from '@/data/pricing';
const enquiry = (name: string) => `/fa/?package=${encodeURIComponent(name)}#callback`;
---
<section class="section persian-pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <header class="section-intro">
      <p class="eyebrow">تعرفه‌های دریچه</p>
      <Headline lines={['قیمت‌ها مشخصه.', 'انتخاب با تو.']} id="pricing-title" />
      <p class="lead">از یه سایت ساده و حرفه‌ای تا فروشگاه اینترنتی یا خدمات ماهانه سئو و پشتیبانی، سعی کردیم قیمت‌ها روشن باشن تا راحت‌تر بتونی تصمیم بگیری.</p>
    </header>
    <div class="group-heading">
      <h3 class="h3">طراحی و راه‌اندازی سایت</h3>
      <p><strong>سه راه برای شروع حضور آنلاین بیزینست.</strong></p>
    </div>
    <div class="plans plans--oneoff">
      {oneOffServices.map((plan) => (
        <article class="d-card d-price-card" id={plan.id} aria-labelledby={`${plan.id}-title`}>
          <header class="d-price-card__head">
            <h4 class="d-card__title" id={`${plan.id}-title`}>{plan.title}</h4>
          </header>

          <p class="d-price-card__price-tray">
            {plan.from && <span class="d-price-card__prefix">از </span>}
            <bdi dir="ltr" class="d-price-card__amount">{plan.price}</bdi>
            <span class="d-price-card__period"> — {plan.billingNote}</span>
          </p>

          <div class="d-price-card__copy">
            <p class="d-price-card__tagline"><strong>{plan.tagline}</strong></p>
            <p class="d-price-card__desc"><PersianText text={plan.text} /></p>
          </div>

          <div class="d-price-card__features">
            <p class="d-price-card__list-label">{plan.listLabel}</p>
            <ul class="d-price-card__list" role="list">{plan.features.map((feature) => <li><PersianText text={feature} /></li>)}</ul>
          </div>

          <div class="d-price-card__cta">
            <a class="btn btn-secondary" href={enquiry(plan.title)}>{plan.cta}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section monthly persian-pricing persian-pricing--monthly" id="monthly" aria-labelledby="monthly-title">
  <div class="container">
    <header class="section-intro">
      <p class="eyebrow">همکاری ماهانه با دریچه</p>
      <Headline lines={['سایتت رو ساختی؟', 'حالا نذار همون‌جا بمونه.']} id="monthly-title" />
      <p class="lead">ساختن یه سایت پایان کار نیست. محتوا باید به‌روز بشه، سئو نیاز به کار مداوم داره و خود سایت هم باید مرتب نگهداری بشه.</p>
      <p class="body">برای همین سه تا پکیج ماهانه داریم؛ از نگهداری و سئوی پایه تا مدیریت گسترده‌تر حضور آنلاین بیزینست.</p>
    </header>
    <div class="plans subscriptions">
      {monthlyPackages.map((plan) => (
        <article class:list={['d-card d-price-card', { 'd-card--featured': plan.featured }]} id={plan.id} aria-labelledby={`${plan.id}-title`}>
          <header class="d-price-card__head">
            <div class="d-price-card__top-row">
              <div class="d-price-card__name-wrap">
                <h3 class="d-card__title" id={`${plan.id}-title`}>{plan.title}</h3>
                <bdi dir="ltr" class="d-badge d-badge--alt">{plan.en}</bdi>
              </div>
              {plan.featured && <span class="d-badge d-badge--featured">{plan.featuredLabel ?? 'برای رشد بیشتر'}</span>}
            </div>
          </header>

          <p class="d-price-card__price-tray">
            <bdi dir="ltr" class="d-price-card__amount">{plan.price}</bdi>
            <span class="d-price-card__period"> در ماه</span>
          </p>

          <div class="d-price-card__copy">
            <p class="d-price-card__tagline"><strong>{plan.tagline}</strong></p>
            <div class="d-price-card__desc">{plan.paragraphs.map((p) => <p>{p}</p>)}</div>
          </div>

          <details class="d-price-card__details" data-monthly-features open>
            <summary>
              <span>خدمات این پکیج:</span>
              <span aria-hidden="true" class="d-price-card__toggle"></span>
            </summary>
            <ul class="d-price-card__list" role="list">{plan.features.map((feature) => <li><PersianText text={feature} /></li>)}</ul>
          </details>

          <div class="d-price-card__cta">
            <a class:list={['btn', plan.featured ? 'btn-primary' : 'btn-secondary']} href={enquiry(plan.title)}>{plan.cta}</a>
          </div>
        </article>
      ))}
    </div>
    <div class="d-card d-info-card pricing-help">
      <h3 class="h3">هنوز نمی‌دونی کدوم پکیج مناسبته؟</h3>
      <p class="body">لازم نیست گرون‌ترین گزینه رو انتخاب کنی. درباره بیزینست و چیزی که می‌خوای بهش برسی حرف می‌زنیم تا ببینیم کدوم خدمات واقعاً به کارت میاد.</p>
      <a class="btn btn-primary" href={contactForm}>بیا با هم بررسی کنیم</a>
    </div>
    <div class="pricing-note">
      <p>{pricingNote.fa}</p>
      <a class="link" href="/fa/pricing/">جزئیات کامل تعرفه‌ها</a>
    </div>
  </div>
</section>

<script>
  // All inclusions remain available without JS. Mobile starts collapsed, prices and CTAs stay visible.
  const wide = window.matchMedia('(min-width: 960px)');
  const lists = document.querySelectorAll<HTMLDetailsElement>('[data-monthly-features]');
  const sync = () => lists.forEach((list) => { list.open = wide.matches; });
  sync();
  wide.addEventListener('change', sync);
</script>

<style>
  .persian-pricing { background: var(--paper-2); }
  .persian-pricing--monthly { background: var(--paper); }
  .section-intro { display: grid; gap: 1.5rem; margin-bottom: var(--stack-lg); }
  .group-heading { display: grid; gap: 0.5rem; margin-bottom: 2rem; }
  .plans { display: grid; gap: clamp(1.15rem, 0.9rem + 1vw, 1.65rem); align-items: stretch; }
  .monthly { padding-top: var(--section-sm); }
  .pricing-help { display: grid; gap: 1.25rem; justify-items: start; margin-top: var(--stack-xl); }
  .pricing-note { display: grid; gap: 1rem; justify-items: start; margin-top: 2.5rem; max-width: 52rem; color: var(--ink-3); font-size: var(--fs-small); }

  @media (min-width: 960px) {
    .plans { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 959px) {
    .subscriptions > .d-card--featured { order: -1; }
  }
</style>
