---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { home } from '@/data/pages';
import { primaryServices, supportingServices, supportingOfferings } from '@/data/services';
import SectionHeading from '../SectionHeading.astro';
import ServiceFeature from '../ServiceFeature.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const lighter = [
  ...supportingServices.map((s) => ({ name: s.name[lang], blurb: s.homeBlurb[lang], link: href(lang, s.slug) })),
  ...supportingOfferings.map((o) => ({ name: o.name[lang], blurb: o.blurb[lang], link: href(lang, o.link) })),
];
---
<section class="services section" id="services" aria-labelledby="services-title">
  <div class="container">
    <SectionHeading eyebrow={home.services.eyebrow[lang]} title={home.services.title[lang]} id="services-title" />

    <div class="services__primary">
      {primaryServices.map((s, i) => <ServiceFeature service={s} index={i} lang={lang} />)}
    </div>

    <div class="services__more">
      <p class="services__label" data-reveal>{home.services.supportingLabel[lang]}</p>
      <ul class="services__list" role="list">
        {lighter.map((s, i) => (
          <li data-reveal style={`--delay:${(i % 3) * 0.06}s`}>
            <a href={s.link} class="services__item">
              <span class="services__name">{s.name}</span>
              <span class="services__blurb">{s.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="services__cta" data-reveal>
      <a href={href(lang, 'services')} class="link-arrow">{t.seeServices}<Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .services__more {
    display: grid;
    gap: 2rem;
    margin-top: var(--stack-xl);
  }
  .services__label {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  .services__list {
    display: grid;
    gap: 0 var(--col-gap);
  }
  @media (min-width: 640px) {
    .services__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .services__more {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
    .services__label {
      grid-column: 1 / span 2;
      padding-top: 1.4rem;
    }
    .services__list {
      grid-column: 3 / -1;
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .services__item {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid var(--line);
    transition: border-color 0.3s;
  }
  .services__item:hover {
    border-color: var(--green);
  }
  .services__name {
    font-weight: 500;
    font-size: 1.1rem;
    transition: color 0.25s;
  }
  .services__item:hover .services__name {
    color: var(--green);
  }
  .services__blurb {
    font-size: var(--fs-small);
    color: var(--ink-3);
    line-height: 1.75;
  }
  .services__cta {
    margin-top: var(--stack-lg);
  }
</style>
