---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { formatGbp, monthlyPackages, oneOffServices } from '@/data/pricing';
import Headline from '../Headline.astro';
import PersianText from './PersianText.astro';
import PrimaryButton from '../PrimaryButton.astro';
import SecondaryButton from '../SecondaryButton.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  /** On /fa/, card CTAs jump straight to the homepage callback form */
  useCallbackAnchor?: boolean;
}
const { lang, useCallbackAnchor = false } = Astro.props;
const t = useTranslations(lang);

const copy = {
  fa: {
    eyebrow: 'تعرفه‌ها',
    title: ['قیمت‌ها،', '*روشن* و بی‌دردسر.'],
    lead: 'خدمات یک‌باره طراحی سایت و فروشگاه، جدا از پکیج‌های ماهانه اختیاری سئو و پشتیبانی.',
    oneOffHeading: 'طراحی و راه‌اندازی سایت (پرداخت یک‌باره)',
    monthlyHeading: 'پکیج‌های ماهانه رشد و پشتیبانی (اختیاری)',
    fullComparison: 'مشاهده همه امکانات، مقایسه پکیج‌ها و جزئیات کامل',
  },
  en: {
    eyebrow: 'Pricing',
    title: ['Prices,', 'out in the *open*.'],
    lead: 'Clear one-off pricing for websites and online shops, kept separate from our optional monthly packages.',
    oneOffHeading: 'One-off Services',
    monthlyHeading: 'Monthly Packages (Optional)',
    fullComparison: 'See full features, package comparison & terms',
  },
}[lang];

const ctaUrl = (id: string, title: string) =>
  useCallbackAnchor
    ? `/fa/?package=${encodeURIComponent(title)}#callback`
    : `${href(lang, 'contact')}?package=${encodeURIComponent(id)}#form`;
---
<section class="home-pricing section--sm" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <header class="home-pricing__head">
      <div class="home-pricing__intro">
        <p class="eyebrow" data-reveal="fade">{copy.eyebrow}</p>
        <Headline lines={copy.title} id="pricing-title" />
      </div>
      <div class="home-pricing__side" data-reveal>
        <p class="lead">{copy.lead}</p>
        <a href={href(lang, 'pricing')} class="link-arrow">{copy.fullComparison}<Icon name="arrow" /></a>
      </div>
    </header>

    <div class="home-pricing__group">
      <h3 class="home-pricing__group-title">{copy.oneOffHeading}</h3>
      <div class="hplans">
        {oneOffServices.map((s) => (
          <article class="hplan" id={s.id} aria-labelledby={`${s.id}-title`}>
            <h4 class="hplan__title" id={`${s.id}-title`}>{s.title[lang]}</h4>
            <p class="hplan__price">
              {s.from && <span class="hplan__prefix">{t.from} </span>}
              <bdi dir="ltr" class="hplan__amount">{formatGbp(s.price)}</bdi>
              <span class="hplan__period">— {s.billingNote[lang]}</span>
            </p>
            <ul class="hplan__list" role="list">
              {s.highlights[lang].map((item) => (
                <li>{lang === 'fa' ? <PersianText text={item} /> : item}</li>
              ))}
            </ul>
            <div class="hplan__cta">
              <SecondaryButton href={ctaUrl(s.id, s.title.fa)} icon="arrow">{s.cta[lang]}</SecondaryButton>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="home-pricing__group" id="monthly">
      <h3 class="home-pricing__group-title">{copy.monthlyHeading}</h3>
      <div class="hplans hplans--monthly">
        {monthlyPackages.map((p) => (
          <article class:list={['hplan', { 'hplan--featured': p.featured }]} id={p.id} aria-labelledby={`${p.id}-title`}>
            <div class="hplan__name-row">
              <h4 class="hplan__title" id={`${p.id}-title`}>{p.title[lang]}</h4>
              <bdi dir={lang === 'fa' ? 'ltr' : 'rtl'} lang={lang === 'fa' ? 'en-GB' : 'fa'} class="hplan__alt">
                {p.secondaryName[lang]}
              </bdi>
              {p.featured && p.featuredLabel && <span class="hplan__badge">{p.featuredLabel[lang]}</span>}
            </div>
            <p class="hplan__price">
              <bdi dir="ltr" class="hplan__amount">{formatGbp(p.price)}</bdi>
              <span class="hplan__period">{t.perMonth}</span>
            </p>
            <ul class="hplan__list" role="list">
              {p.highlights[lang].map((item) => (
                <li>{lang === 'fa' ? <PersianText text={item} /> : item}</li>
              ))}
            </ul>
            <div class="hplan__cta">
              {p.featured ? (
                <PrimaryButton href={ctaUrl(p.id, p.title.fa)} icon="arrow">{p.cta[lang]}</PrimaryButton>
              ) : (
                <SecondaryButton href={ctaUrl(p.id, p.title.fa)} icon="arrow">{p.cta[lang]}</SecondaryButton>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="home-pricing__foot" data-reveal>
      <a href={href(lang, 'pricing')} class="link-arrow">{copy.fullComparison}<Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .home-pricing {
    background: var(--paper-2);
  }
  .home-pricing__head {
    display: grid;
    gap: var(--stack-md);
    margin-bottom: var(--stack-lg);
    align-items: end;
  }
  .home-pricing__intro {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .home-pricing__side {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .home-pricing__group {
    display: grid;
    gap: 1.25rem;
    scroll-margin-top: 7rem;
  }
  .home-pricing__group + .home-pricing__group {
    margin-top: var(--stack-lg);
  }
  .home-pricing__group-title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  .hplans {
    display: grid;
    gap: 1.25rem var(--col-gap);
    align-items: stretch;
  }
  .hplan {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.6rem 1.4rem;
    background: var(--paper);
    border-top: 1px solid var(--ink);
    border-radius: 0 0 var(--radius) var(--radius);
    min-width: 0;
    scroll-margin-top: 7rem;
  }
  .hplan--featured {
    border: 1px solid var(--green);
    border-top: 3px solid var(--green);
    border-radius: var(--radius);
  }
  .hplan__name-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.65rem;
  }
  .hplan__title {
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
  }
  .hplan__alt {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .hplan__badge {
    width: 100%;
    font-size: var(--fs-micro);
    font-weight: 500;
    color: var(--red);
  }
  .hplan__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--green);
    line-height: 1.15;
  }
  .hplan__prefix {
    font-size: var(--fs-small);
    color: var(--green);
  }
  .hplan__amount {
    font-size: clamp(2.1rem, 1.7rem + 1.3vw, 2.85rem);
    font-weight: 200;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .hplan__period {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .hplan__list {
    display: grid;
    gap: 0.45rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .hplan__list li {
    position: relative;
    padding-inline-start: 0.9rem;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--ink-2);
    text-align: start;
  }
  .hplan__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.75em;
    width: 4px;
    height: 4px;
    background: var(--green);
  }
  .hplan__cta {
    margin-top: auto;
    padding-top: 0.4rem;
  }
  .hplan__cta :global(.btn) {
    width: 100%;
    min-height: 3rem;
    white-space: normal;
    text-align: center;
    padding-block: 0.7rem;
  }
  .home-pricing__foot {
    margin-top: var(--stack-md);
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 960px) {
    .home-pricing__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
    .home-pricing__intro {
      grid-column: 1 / span 6;
    }
    .home-pricing__side {
      grid-column: 7 / -1;
    }
    .hplans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 959px) {
    .hplans--monthly > .hplan--featured {
      order: -1;
    }
  }
</style>
