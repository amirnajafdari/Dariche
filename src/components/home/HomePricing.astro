---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { formatGbp, monthlyPackages, oneOffServices } from '@/data/pricing';
import Headline from '../Headline.astro';
import PersianText from './PersianText.astro';
import PrimaryButton from '../PrimaryButton.astro';
import SecondaryButton from '../SecondaryButton.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  /** On /fa/, card CTAs jump straight to the homepage callback form */
  useCallbackAnchor?: boolean;
}
const { lang, useCallbackAnchor = false } = Astro.props;
const t = useTranslations(lang);

const copy = {
  fa: {
    eyebrow: 'تعرفه‌ها',
    title: ['قیمت‌ها،', '*روشن* و بی‌دردسر.'],
    lead: 'خدمات یک‌باره طراحی سایت و فروشگاه، جدا از پکیج‌های ماهانه اختیاری سئو و پشتیبانی.',
    oneOffHeading: 'طراحی و راه‌اندازی سایت (پرداخت یک‌باره)',
    monthlyHeading: 'پکیج‌های ماهانه رشد و پشتیبانی (اختیاری)',
    fullComparison: 'مشاهده همه امکانات، مقایسه پکیج‌ها و جزئیات کامل',
  },
  en: {
    eyebrow: 'Pricing',
    title: ['Prices,', 'out in the *open*.'],
    lead: 'Clear one-off pricing for websites and online shops, kept separate from our optional monthly packages.',
    oneOffHeading: 'One-off Services',
    monthlyHeading: 'Monthly Packages (Optional)',
    fullComparison: 'See full features, package comparison & terms',
  },
}[lang];

const ctaUrl = (id: string, title: string) =>
  useCallbackAnchor
    ? `/fa/?package=${encodeURIComponent(title)}#callback`
    : `${href(lang, 'contact')}?package=${encodeURIComponent(id)}#form`;
---
<section class="home-pricing section--sm" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <header class="home-pricing__head">
      <div class="home-pricing__intro">
        <p class="eyebrow" data-reveal="fade">{copy.eyebrow}</p>
        <Headline lines={copy.title} id="pricing-title" />
      </div>
      <div class="home-pricing__side" data-reveal>
        <p class="lead">{copy.lead}</p>
        <a href={href(lang, 'pricing')} class="link-arrow">{copy.fullComparison}<Icon name="arrow" /></a>
      </div>
    </header>

    <div class="home-pricing__group">
      <h3 class="home-pricing__group-title">{copy.oneOffHeading}</h3>
      <div class="hplans">
        {oneOffServices.map((s) => (
          <article class="d-card d-price-card d-price-card--compact" id={s.id} aria-labelledby={`${s.id}-title`}>
            <header class="d-price-card__head">
              <h4 class="d-card__title" id={`${s.id}-title`}>{s.title[lang]}</h4>
            </header>

            <p class="d-price-card__price-tray">
              {s.from && <span class="d-price-card__prefix">{t.from} </span>}
              <bdi dir="ltr" class="d-price-card__amount">{formatGbp(s.price)}</bdi>
              <span class="d-price-card__period">— {s.billingNote[lang]}</span>
            </p>

            <div class="d-price-card__features">
              <ul class="d-price-card__list" role="list">
                {s.highlights[lang].map((item) => (
                  <li>{lang === 'fa' ? <PersianText text={item} /> : item}</li>
                ))}
              </ul>
            </div>

            <div class="d-price-card__cta">
              <SecondaryButton href={ctaUrl(s.id, s.title.fa)} icon="arrow">{s.cta[lang]}</SecondaryButton>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="home-pricing__group" id="monthly">
      <h3 class="home-pricing__group-title">{copy.monthlyHeading}</h3>
      <div class="hplans hplans--monthly">
        {monthlyPackages.map((p) => (
          <article
            class:list={['d-card d-price-card d-price-card--compact', { 'd-card--featured': p.featured }]}
            id={p.id}
            aria-labelledby={`${p.id}-title`}
          >
            <header class="d-price-card__head">
              <div class="d-price-card__top-row">
                <div class="d-price-card__name-wrap">
                  <h4 class="d-card__title" id={`${p.id}-title`}>{p.title[lang]}</h4>
                  <bdi dir={lang === 'fa' ? 'ltr' : 'rtl'} lang={lang === 'fa' ? 'en-GB' : 'fa'} class="d-badge d-badge--alt">
                    {p.secondaryName[lang]}
                  </bdi>
                </div>
                {p.featured && p.featuredLabel && (
                  <span class="d-badge d-badge--featured">{p.featuredLabel[lang]}</span>
                )}
              </div>
            </header>

            <p class="d-price-card__price-tray">
              <bdi dir="ltr" class="d-price-card__amount">{formatGbp(p.price)}</bdi>
              <span class="d-price-card__period">{t.perMonth}</span>
            </p>

            <div class="d-price-card__features">
              <ul class="d-price-card__list" role="list">
                {p.highlights[lang].map((item) => (
                  <li>{lang === 'fa' ? <PersianText text={item} /> : item}</li>
                ))}
              </ul>
            </div>

            <div class="d-price-card__cta">
              {p.featured ? (
                <PrimaryButton href={ctaUrl(p.id, p.title.fa)} icon="arrow">{p.cta[lang]}</PrimaryButton>
              ) : (
                <SecondaryButton href={ctaUrl(p.id, p.title.fa)} icon="arrow">{p.cta[lang]}</SecondaryButton>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="home-pricing__foot" data-reveal>
      <a href={href(lang, 'pricing')} class="link-arrow">{copy.fullComparison}<Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .home-pricing {
    background: var(--paper-2);
  }
  .home-pricing__head {
    display: grid;
    gap: var(--stack-md);
    margin-bottom: var(--stack-lg);
    align-items: end;
  }
  .home-pricing__intro {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .home-pricing__side {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .home-pricing__group {
    display: grid;
    gap: 1.35rem;
    scroll-margin-top: 7rem;
  }
  .home-pricing__group + .home-pricing__group {
    margin-top: var(--stack-xl);
  }
  .home-pricing__group-title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  :global([lang='fa']) .home-pricing__group-title {
    font-family: var(--font-fa);
    font-weight: 600;
  }
  .home-pricing__group-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .hplans {
    display: grid;
    gap: clamp(1.15rem, 0.9rem + 1vw, 1.65rem);
    align-items: stretch;
  }
  .home-pricing__foot {
    margin-top: var(--stack-lg);
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 960px) {
    .home-pricing__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
    .home-pricing__intro {
      grid-column: 1 / span 6;
    }
    .home-pricing__side {
      grid-column: 7 / -1;
    }
    .hplans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 959px) {
    .hplans--monthly > .d-card--featured {
      order: -1;
    }
  }
</style>
