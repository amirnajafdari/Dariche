---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { home } from '@/data/pages';
import { caseStudies } from '@/data/caseStudies';
import { visible } from '@/data/site';
import SectionHeading from '../SectionHeading.astro';
import CaseStudyCard from '../CaseStudyCard.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = visible(caseStudies);
---
{items.length > 0 && (
  <section class="work section" aria-labelledby="work-title">
    <div class="container">
      <SectionHeading eyebrow={home.work.eyebrow[lang]} title={home.work.title[lang]} id="work-title" />
      <div class="work__grid">
        {items.map((cs) => (
          <CaseStudyCard cs={cs} lang={lang} />
        ))}
      </div>
      <div class="work__cta" data-reveal>
        <a href={href(lang, 'work')} class="link-arrow">{t.viewAllWork}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>
)}

<style>
  .work__grid {
    display: grid;
    gap: var(--col-gap);
  }
  @media (min-width: 700px) {
    .work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .work__cta {
    margin-top: var(--stack-xl);
    display: flex;
    justify-content: center;
  }
</style>
