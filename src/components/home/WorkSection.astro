---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { home } from '@/data/pages';
import { caseStudies } from '@/data/caseStudies';
import { visible } from '@/data/site';
import SectionHeading from '../SectionHeading.astro';
import CaseStudyCard from '../CaseStudyCard.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = visible(caseStudies);
// Asymmetric rhythm: wide, tall offset, tall, wide offset.
const shapes = ['wide', 'tall', 'tall', 'wide'] as const;
---
{items.length > 0 && (
  <section class="work section" aria-labelledby="work-title">
    <div class="container">
      <SectionHeading eyebrow={home.work.eyebrow[lang]} title={home.work.title[lang]} id="work-title" />
      <div class="work__grid">
        {items.map((cs, i) => (
          <CaseStudyCard cs={cs} lang={lang} shape={shapes[i % 4]} class={`work__item work__item--${(i % 4) + 1}`} />
        ))}
      </div>
      <div class="work__cta" data-reveal>
        <a href={href(lang, 'work')} class="link-arrow">{t.viewAllWork}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>
)}

<style>
  .work__grid {
    display: grid;
    gap: var(--stack-xl);
  }
  @media (min-width: 700px) {
    .work__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      row-gap: var(--stack-xl);
      align-items: start;
    }
    .work__grid > :global(.work__item--1) {
      grid-column: 1 / span 8;
    }
    .work__grid > :global(.work__item--2) {
      grid-column: 9 / span 4;
      margin-top: clamp(6rem, 2rem + 10vw, 14rem);
    }
    .work__grid > :global(.work__item--3) {
      grid-column: 2 / span 4;
    }
    .work__grid > :global(.work__item--4) {
      grid-column: 6 / span 7;
      margin-top: clamp(4rem, 2rem + 8vw, 11rem);
    }
  }
  .work__cta {
    margin-top: var(--stack-xl);
    display: flex;
    justify-content: center;
  }
</style>
