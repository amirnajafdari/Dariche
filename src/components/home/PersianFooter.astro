---
import type { Lang } from '@/i18n';
import Footer from '../Footer.astro';
import { persianHomeContact } from '@/data/persianHome';

interface Props {
  alternates?: Partial<Record<Lang, string>>;
}
const { alternates = { fa: '/fa/', en: '/en/' } } = Astro.props;
---
<Footer lang="fa" alternates={alternates} email={persianHomeContact.email} />
