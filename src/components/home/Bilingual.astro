---
import type { Lang } from '@/i18n';
import { home } from '@/data/pages';
import Headline from '../Headline.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const b = home.bilingual;
---
<section class="bi section" aria-labelledby="bi-title">
  <div class="container bi__grid">
    <div class="bi__copy">
      <Headline lines={b.title[lang]} id="bi-title" />
      <p class="body" data-reveal>{b.text[lang]}</p>
      <ul class="bi__points" role="list" data-reveal>
        {b.points[lang].map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <!-- one frame, two directions -->
    <div class="bi__frame window" aria-hidden="true" data-reveal>
      <div class="window__pane bi__pane">
        <div class="bi__half bi__half--fa" dir="rtl" lang="fa">
          <span class="bi__dir">RTL ←</span>
          <p>{b.sampleFa}</p>
        </div>
        <div class="bi__half bi__half--en" dir="ltr" lang="en-GB">
          <span class="bi__dir">LTR →</span>
          <p>{b.sampleEn}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bi__grid {
    display: grid;
    gap: var(--stack-xl);
  }
  .bi__copy {
    display: grid;
    gap: var(--stack-md);
    align-content: start;
  }
  .bi__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .bi__points li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .bi__points li::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--green);
  }
  .bi__pane {
    display: grid;
    grid-template-rows: 1fr 1fr;
    aspect-ratio: 5 / 4;
    background: var(--paper);
    border: 1px solid var(--ink);
  }
  .bi__half {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    padding: clamp(1.25rem, 0.5rem + 3vw, 3rem);
  }
  .bi__half--fa {
    font-family: var(--font-fa);
    border-bottom: 1px solid var(--line);
  }
  .bi__half--en {
    font-family: var(--font-en);
    background: var(--paper-2);
  }
  .bi__half p {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.6rem);
    font-weight: 300;
    line-height: 1.3;
  }
  .bi__half--en p {
    letter-spacing: -0.03em;
  }
  .bi__dir {
    font-family: var(--font-en);
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    color: var(--green);
  }
  @media (min-width: 960px) {
    .bi__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: center;
    }
    .bi__copy {
      grid-column: 1 / span 5;
    }
    .bi__frame {
      grid-column: 7 / -1;
    }
  }
</style>
