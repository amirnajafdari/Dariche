---
import type { Lang } from '@/i18n';
import type { Founder } from '@/data/founders';

interface Props {
  founder: Founder;
  lang: Lang;
  showBio?: boolean;
  class?: string;
}
const { founder, lang, showBio = false, class: className } = Astro.props;
---
<figure class:list={['founder', className]} data-reveal>
  <div class="founder__frame">
    {founder.photo ? (
      <img
        src={founder.photo.src}
        alt={founder.photo.alt[lang]}
        width={founder.photo.width}
        height={founder.photo.height}
        style={founder.photoPosition ? `object-position: ${founder.photoPosition}` : undefined}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="founder__placeholder" aria-hidden="true">
        <span>{founder.initials}</span>
      </div>
    )}
  </div>
  <figcaption class="founder__caption">
    <span class="founder__name">{founder.name[lang]}</span>
    <span class="founder__role">{founder.role[lang]}</span>
    {showBio && <span class="founder__bio">{founder.bio[lang]}</span>}
  </figcaption>
</figure>

<style>
  .founder {
    display: grid;
    gap: 1.5rem;
  }
  /* a soft arch: the one curved window on the site */
  .founder__frame {
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    background: var(--paper-2);
    /* a second, offset arch drawn with rings so it follows the curve */
    box-shadow:
      0 0 0 10px var(--paper),
      0 0 0 11px var(--line);
    margin: 11px;
  }
  .founder__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder__placeholder {
    height: 100%;
    display: grid;
    place-items: end center;
    padding-bottom: 18%;
  }
  .founder__placeholder span {
    font-family: var(--font-en);
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    font-weight: 200;
    color: var(--line-strong);
    line-height: 1;
  }
  .founder__caption {
    display: grid;
    gap: 0.2rem;
  }
  .founder__name {
    font-weight: 500;
    font-size: 1.15rem;
  }
  .founder__role {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .founder__bio {
    margin-top: 0.75rem;
    color: var(--ink-2);
    max-width: 28rem;
  }
</style>
