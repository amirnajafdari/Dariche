---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { home } from '@/data/pages';
import Headline from './Headline.astro';
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import HomeIllustration from './home/HomeIllustration.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <Headline lines={home.hero.title[lang]} as="h1" size="display" id="hero-title" class="hero__title" />
      <div class="hero__text" data-reveal style="--delay:.25s">
        <p class="lead">{home.hero.lead[lang]}</p>
        <p class="hero__sub">{home.hero.sub[lang]}</p>
      </div>
      <div class="hero__actions" data-reveal style="--delay:.35s" data-hide-wa>
        <div class="btn-row">
          <PrimaryButton href={href(lang, 'contact')}>{t.letsTalk}</PrimaryButton>
          <SecondaryButton href={href(lang, 'work')}>{t.seeOurWork}</SecondaryButton>
        </div>
        <WhatsAppButton lang={lang} variant="quiet" />
      </div>
    </div>

    <div class="hero__visual">
      <HomeIllustration scene="website" priority />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 1rem + 6vw, 7rem) var(--section);
  }
  .hero__grid {
    display: grid;
    gap: var(--stack-xl);
  }
  .hero__copy {
    display: grid;
    gap: var(--stack-md);
    align-content: center;
  }
  .hero__title {
    font-size: clamp(2.7rem, 1.2rem + 6.4vw, 7.2rem);
  }
  .hero__text {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .hero__sub {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }
  .hero__actions {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 1rem;
  }

  .hero__visual {
    align-self: center;
    min-width: 0;
    background: #fff;
  }

  @media (min-width: 960px) {
    .hero {
      padding-top: clamp(3rem, 1rem + 4vw, 6rem);
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: center;
      min-height: min(78vh, 52rem);
    }
    .hero__copy {
      grid-column: 1 / span 7;
    }
    .hero__visual {
      grid-column: 8 / -1;
    }
  }
</style>
