---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { home } from '@/data/pages';
import Headline from './Headline.astro';
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="hero" aria-labelledby="hero-title">
  <img
    class="hero__bg"
    src="/images/hero/hero-en.webp"
    alt=""
    aria-hidden="true"
    width="1024"
    height="576"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <Headline lines={home.hero.title[lang]} as="h1" size="display" id="hero-title" class="hero__title" />
      <div class="hero__text" data-reveal style="--delay:.25s">
        <p class="lead">{home.hero.lead[lang]}</p>
        <p class="hero__sub">{home.hero.sub[lang]}</p>
      </div>
      <div class="hero__actions" data-reveal style="--delay:.35s" data-hide-wa>
        <div class="btn-row">
          <PrimaryButton href={href(lang, 'contact')}>{t.letsTalk}</PrimaryButton>
          <SecondaryButton href={href(lang, 'work')}>{t.seeOurWork}</SecondaryButton>
        </div>
        <WhatsAppButton lang={lang} variant="quiet" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #f6f4f1;
    padding-top: clamp(2.75rem, 6vw, 4.5rem);
    padding-bottom: clamp(16rem, 54vw, 24rem);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 82% bottom;
    z-index: -2;
    pointer-events: none;
    user-select: none;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.92) 0%,
      rgb(255 255 255 / 0.84) 46%,
      rgb(255 255 255 / 0.08) 76%,
      transparent 100%
    );
  }
  .hero__grid {
    position: relative;
    display: grid;
  }
  .hero__copy {
    display: grid;
    gap: var(--stack-md);
    align-content: center;
    max-width: 34rem;
  }
  .hero__title {
    font-size: clamp(2.5rem, 1.2rem + 4.4vw, 5.4rem);
  }
  .hero__text {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }
  .hero__sub {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }
  .hero__actions {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 0.75rem;
  }

  @media (min-width: 960px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: clamp(38rem, 78vh, 52rem);
      padding-block: clamp(4rem, 5vw, 6.5rem);
    }
    .hero__bg {
      object-position: right center;
    }
    .hero__veil {
      background: linear-gradient(
        to right,
        rgb(255 255 255 / 0.72) 0%,
        rgb(255 255 255 / 0.42) 40%,
        transparent 56%
      );
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: center;
    }
    .hero__copy {
      grid-column: 1 / span 6;
    }
  }

  @media (min-width: 1240px) {
    .hero__veil {
      background: linear-gradient(
        to right,
        rgb(255 255 255 / 0.35) 0%,
        rgb(255 255 255 / 0.12) 38%,
        transparent 50%
      );
    }
    .hero__copy {
      grid-column: 1 / span 5;
    }
  }
</style>
