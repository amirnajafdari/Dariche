---
import { langMeta, type Lang } from '@/i18n';
import { site } from '@/data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Absolute-path canonical, e.g. /fa/seo/ */
  canonical: string;
  /** Equivalent page per language (paths). Only include languages where the page truly exists. */
  alternates: Partial<Record<Lang, string>>;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Alternative search phrases (incl. Finglish). Metadata only — see src/data/seo.ts */
  keywords?: string[];
  schema?: object;
  publishedTime?: string;
}
const { lang, title, description, canonical, alternates, image = site.ogImage, type = 'website', noindex, keywords, schema, publishedTime } = Astro.props;

const abs = (p: string) => new URL(p, site.url).toString();
const alt = Object.entries(alternates) as [Lang, string][];
const xDefault = alternates[site.xDefaultLang] ?? alternates[lang];
const otherLocales = alt.filter(([l]) => l !== lang).map(([l]) => langMeta[l].ogLocale);
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={abs(canonical)} />}
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

{!noindex && alt.length > 1 && alt.map(([l, p]) => <link rel="alternate" hreflang={langMeta[l].hreflang} href={abs(p)} />)}
{!noindex && alt.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name[lang]} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={abs(canonical)} />
<meta property="og:image" content={abs(image)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={langMeta[lang].ogLocale} />
{otherLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={abs(image)} />

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
