---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { formatGbp, type MonthlyPackage } from '@/data/pricing';
import PersianText from './home/PersianText.astro';
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';

interface Props {
  pkg: MonthlyPackage;
  lang: Lang;
  headingLevel?: 'h2' | 'h3' | 'h4';
  ctaHref?: string;
}

const { pkg, lang, headingLevel: H = 'h3', ctaHref } = Astro.props;
const t = useTranslations(lang);
const contactUrl = ctaHref ?? `${href(lang, 'contact')}?package=${encodeURIComponent(pkg.id)}#form`;
const amount = formatGbp(pkg.price);
---
<article
  class:list={['d-card d-price-card monthly-card', { 'd-card--featured monthly-card--featured': pkg.featured }]}
  id={pkg.id}
  aria-labelledby={`monthly-${pkg.id}`}
>
  <header class="d-price-card__head">
    <div class="d-price-card__top-row">
      <div class="d-price-card__name-wrap">
        <H class="d-card__title" id={`monthly-${pkg.id}`}>{pkg.title[lang]}</H>
        <bdi dir={lang === 'fa' ? 'ltr' : 'rtl'} lang={lang === 'fa' ? 'en-GB' : 'fa'} class="d-badge d-badge--alt">
          {pkg.secondaryName[lang]}
        </bdi>
      </div>
      {pkg.featured && pkg.featuredLabel && (
        <span class="d-badge d-badge--featured">{pkg.featuredLabel[lang]}</span>
      )}
    </div>
  </header>

  <p class="d-price-card__price-tray">
    <bdi dir="ltr" class="d-price-card__amount">{amount}</bdi>
    <span class="d-price-card__period">{t.perMonth}</span>
  </p>

  <div class="d-price-card__copy">
    <p class="d-price-card__tagline"><strong>{pkg.tagline[lang]}</strong></p>
    <div class="d-price-card__desc">
      {pkg.paragraphs[lang].map((paragraph) => (
        <p>{lang === 'fa' ? <PersianText text={paragraph} /> : paragraph}</p>
      ))}
    </div>
  </div>

  <details class="d-price-card__details" data-monthly-features open>
    <summary>
      <span>{t.packageFeatures}</span>
      <span aria-hidden="true" class="d-price-card__toggle"></span>
    </summary>
    <ul class="d-price-card__list" role="list">
      {pkg.features[lang].map((feature) => (
        <li>{lang === 'fa' ? <PersianText text={feature} /> : feature}</li>
      ))}
    </ul>
  </details>

  <div class="d-price-card__cta">
    {pkg.featured ? (
      <PrimaryButton href={contactUrl} icon="arrow">{pkg.cta[lang]}</PrimaryButton>
    ) : (
      <SecondaryButton href={contactUrl} icon="arrow">{pkg.cta[lang]}</SecondaryButton>
    )}
  </div>
</article>

<style>
  .monthly-card {
    height: 100%;
  }
</style>
