---
import { href, type Lang } from '@/i18n';
import { useTranslations } from '@/i18n/ui';
import { specLabels, type Package, type SpecKey } from '@/data/packages';
import { price } from '@/lib/text';
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';
import Icon from './Icon.astro';

interface Props {
  pkg: Package;
  lang: Lang;
  /** Show the expandable "full details" list (pricing page) */
  expandable?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { pkg, lang, expandable = false, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(lang);
const specs = Object.keys(specLabels) as SpecKey[];
const contactUrl = `${href(lang, 'contact')}?package=${pkg.id}`;
---
<article class:list={['plan', { 'plan--featured': pkg.featured }]} aria-labelledby={`plan-${pkg.id}`}>
  <div class="plan__head">
    <p class="plan__flag">{pkg.featured && pkg.featuredLabel ? pkg.featuredLabel[lang] : ' '}</p>
    <H class="plan__name" id={`plan-${pkg.id}`}>{pkg.name[lang]}</H>
    <p class="plan__price">
      <span class="plan__from">{t.from}</span>
      <span class="plan__amount">{price(pkg.price, lang)}</span>
      <span class="plan__note">{pkg.priceNote[lang]}</span>
    </p>
    <p class="plan__desc">{pkg.description[lang]}</p>
    <p class="plan__best"><span>{t.bestFor}:</span> {pkg.bestFor[lang]}</p>
  </div>

  <dl class="plan__specs">
    {specs.map((k) => (
      <div>
        <dt>{specLabels[k][lang]}</dt>
        <dd>{pkg.specs[k][lang]}</dd>
      </div>
    ))}
  </dl>

  {expandable && (
    <details class="plan__more">
      <summary>
        <span class="plan__more-open">{t.fullDetails}</span>
        <span class="plan__more-close">{t.lessDetails}</span>
        <Icon name="plus" />
      </summary>
      <ul role="list">
        {pkg.included[lang].map((item) => <li>{item}</li>)}
      </ul>
    </details>
  )}

  <div class="plan__cta">
    {pkg.featured ? (
      <PrimaryButton href={contactUrl}>{t.choosePackage}</PrimaryButton>
    ) : (
      <SecondaryButton href={contactUrl} icon="arrow">{t.choosePackage}</SecondaryButton>
    )}
  </div>
</article>

<style>
  .plan {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 2rem 0;
    border-top: 1px solid var(--ink);
    position: relative;
  }
  .plan--featured {
    border-top: 3px solid var(--green);
    padding-top: calc(2rem - 2px);
  }
  .plan__head {
    display: grid;
    gap: 0.85rem;
  }
  .plan__flag {
    font-size: var(--fs-small);
    color: var(--green);
    font-weight: 500;
    min-height: 1.5em;
    line-height: 1.5;
  }
  .plan__name {
    font-size: var(--fs-h3);
    font-weight: 500;
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .plan__from,
  .plan__note {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .plan__amount {
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    font-weight: 200;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .plan__desc {
    color: var(--ink-2);
    min-height: 3.4em;
  }
  .plan__best {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .plan__best span {
    color: var(--ink);
    font-weight: 500;
  }
  .plan__specs {
    display: grid;
  }
  .plan__specs div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
  }
  .plan__specs dt {
    color: var(--ink-3);
  }
  .plan__specs dd {
    text-align: end;
    font-weight: 500;
  }
  .plan__more {
    border-top: 1px solid var(--line);
  }
  .plan__more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--green);
  }
  .plan__more summary::-webkit-details-marker {
    display: none;
  }
  .plan__more summary .icon {
    transition: transform 0.3s var(--ease);
  }
  .plan__more[open] summary .icon {
    transform: rotate(45deg);
  }
  .plan__more-close,
  .plan__more[open] .plan__more-open {
    display: none;
  }
  .plan__more[open] .plan__more-close {
    display: inline;
  }
  .plan__more ul {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 1.25rem;
  }
  .plan__more li {
    position: relative;
    padding-inline-start: 1.25rem;
    color: var(--ink-2);
  }
  .plan__more li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.85em;
    width: 0.5rem;
    height: 1px;
    background: var(--green);
  }
  .plan__cta {
    margin-top: auto;
  }
  .plan__cta :global(.btn) {
    width: 100%;
  }
</style>
